# Razorpay test-mode credentials, from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Create a webhook in Razorpay Dashboard for payment_link.paid and use the same secret here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Use a long random secret in production. Changing it signs out active sessions.
APP_SESSION_SECRET=replace_with_a_long_random_secret

# Optional: enables natural multilingual AI conversations through Groq.
GROQ_API_KEY=your_groq_api_key
